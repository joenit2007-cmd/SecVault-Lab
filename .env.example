# Copy this file to .env for local development.
# Do NOT commit your real .env file to version control.

# Security mode: "secure" (recommended default) or "vulnerable" (local lab testing only)
APP_SECURITY_MODE=secure

# Generate a strong secret key locally with:
# python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace-with-a-locally-generated-random-secret-key

# Set to true when deploying behind HTTPS
SESSION_COOKIE_SECURE=false

# Local SQLite database path (stored inside ignored instance/ folder by default)
DATABASE_PATH=instance/secvault.db

# Optional: Only used if you run scripts/seed_demo_data.py non-interactively
# DEMO_ADMIN_PASSWORD=
# DEMO_USER_PASSWORD=
